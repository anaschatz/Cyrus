#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if git diff --cached --quiet --; then
  exit 0
fi

{
  printf '%s\n\n' '@ponytail-review Review only this staged diff for unnecessary complexity. Do not edit files or run Git commands.'
  git diff --cached --no-ext-diff --unified=80 --
} | "$repo_root/.githooks/run-ponytail-review" "pre-commit"

