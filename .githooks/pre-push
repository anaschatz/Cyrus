#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
remote_name=$1
review_input=$(mktemp "${TMPDIR:-/tmp}/ponytail-push.XXXXXX")
trap 'rm -f "$review_input"' EXIT HUP INT TERM

printf '%s\n\n' '@ponytail-review Review only these outgoing changes for unnecessary complexity. Do not edit files or run Git commands.' >"$review_input"
has_changes=false
zero=0000000000000000000000000000000000000000

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero" ]; then
    continue
  fi

  if [ "$remote_oid" != "$zero" ]; then
    git diff --no-ext-diff --unified=80 "$remote_oid" "$local_oid" -- >>"$review_input"
    has_changes=true
    continue
  fi

  outgoing=$(git rev-list --reverse "$local_oid" --not --remotes="$remote_name")
  if [ -z "$outgoing" ]; then
    continue
  fi
  oldest=$(printf '%s\n' "$outgoing" | sed -n '1p')
  base=$(git rev-parse "$oldest^" 2>/dev/null) || base=$(git hash-object -t tree /dev/null)
  git diff --no-ext-diff --unified=80 "$base" "$local_oid" -- >>"$review_input"
  has_changes=true
done

if [ "$has_changes" = false ]; then
  exit 0
fi

"$repo_root/.githooks/run-ponytail-review" "pre-push" <"$review_input"

