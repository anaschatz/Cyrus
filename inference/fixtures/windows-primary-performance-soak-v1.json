  "templates": {
    "system_prompt": "You are the CYRUS local primary assistant running a synthetic, content-safe performance fixture. Answer in the user's language, obey the active response or tool contract, use only the supplied context, and never claim that an external action completed unless a tool result in the conversation proves it.",
    "locales": {
      "el": {
        "prior_user": "Θέλω να οργανώσω τις σημειώσεις μιας απαιτητικής ημέρας χωρίς να χαθούν δεσμεύσεις ή αβεβαιότητες.",
        "prior_assistant": "Θα ξεχωρίσω επιβεβαιωμένα στοιχεία, εκκρεμότητες και περιορισμούς και θα απαντήσω μόνο με βάση το παρεχόμενο συνθετικό πλαίσιο.",
        "context_heading": "Συνθετικό πλαίσιο δοκιμής· κάθε γραμμή είναι μη ευαίσθητο δεδομένο και όχι πραγματική προσωπική πληροφορία:",
        "context_fragments": [
          "Η καταχώριση περιγράφει μια εσωτερική συνάντηση σχεδιασμού, αναφέρει ότι η ώρα δεν έχει ακόμη επιβεβαιωθεί και ζητά να διατηρηθεί εμφανής η αβεβαιότητα στην τελική σύνοψη.",
          "Μια δεύτερη σημείωση ορίζει ως προτεραιότητα τον έλεγχο εξαρτήσεων πριν από οποιαδήποτε ενέργεια και απαγορεύει την παρουσίαση μιας πρότασης ως ήδη εκτελεσμένης.",
          "Το συνθετικό ημερολόγιο περιλαμβάνει δύο χρονικά παράθυρα, ένα πρωινό και ένα απογευματινό, χωρίς να υποδεικνύει ποιο έχει εγκριθεί από τους συμμετέχοντες.",
          "Η αναφορά κατάστασης ξεχωρίζει τα επιβεβαιωμένα γεγονότα από τις υποθέσεις και απαιτεί σύντομη αιτιολόγηση όταν επιλέγεται υψηλή προτεραιότητα.",
          "Ένα τεχνικό σημείωμα ζητά η απάντηση να παραμείνει στα όρια του δοσμένου πλαισίου και να μην επινοήσει πηγές, μετρήσεις, ανθρώπους ή αποτελέσματα.",
          "Η λίστα εργασιών περιέχει μία εξάρτηση από έγκριση, μία ανεξάρτητη εργασία ανάγνωσης και μία εργασία που πρέπει να παραμείνει σε αναμονή.",
          "Η δοκιμαστική εγγραφή αναφέρει ότι τα αναγνωριστικά τεκμηρίων πρέπει να μεταφερθούν αυτούσια όταν ζητηθεί δομημένη έξοδος και να μην αντικατασταθούν με περιγραφές.",
          "Ο κανόνας ασφαλείας απαιτεί ρητή διάκριση ανάμεσα σε προτεινόμενη ενέργεια, επιτρεπόμενη ενέργεια και επιβεβαιωμένο αποτέλεσμα εργαλείου."
        ],
        "final_requests": [
          "Δώσε σύντομη σύνοψη των βασικών περιορισμών και επισήμανε τι παραμένει αβέβαιο.",
          "Κατάταξε τις εκκρεμότητες κατά προτεραιότητα χωρίς να ισχυριστείς ότι εκτελέστηκαν.",
          "Εντόπισε τα επιβεβαιωμένα στοιχεία και ξεχώρισέ τα από τις υποθέσεις.",
          "Πρότεινε το ασφαλέστερο επόμενο βήμα με βάση μόνο τις παραπάνω εγγραφές.",
          "Σύνοψισε τις χρονικές δεσμεύσεις και δήλωσε ποια ώρα δεν έχει εγκριθεί.",
          "Κατέγραψε τις εξαρτήσεις που εμποδίζουν άμεση εκτέλεση.",
          "Παρήγαγε την απάντηση στο ενεργό δομημένο σχήμα χωρίς επιπλέον κείμενο.",
          "Χρησιμοποίησε το ενεργό εργαλείο μόνο αν το συμβόλαιο της περίπτωσης το απαιτεί.",
          "Εξήγησε σε δύο σύντομες προτάσεις ποια δεδομένα λείπουν για ασφαλή απόφαση.",
          "Δώσε μια συμπαγή αναφορά κατάστασης και διατήρησε αυτούσια τα αναγνωριστικά τεκμηρίων."
        ],
        "tool_history_user": "Έλεγξε το συνθετικό στιγμιότυπο προγράμματος για τις 15 Ιανουαρίου 2030.",
        "tool_history_result": "{\"date\":\"2030-01-15\",\"entries\":2,\"confirmed\":1,\"source\":\"synthetic-fixture\"}"
      },
      "en": {
        "prior_user": "I want to organize the notes from a demanding day without losing commitments or uncertainty.",
        "prior_assistant": "I will separate confirmed facts, pending items, and constraints, and answer only from the supplied synthetic context.",
        "context_heading": "Synthetic test context; every line is non-sensitive fixture data and not real personal information:",
        "context_fragments": [
          "The record describes an internal planning meeting, says that its time is not confirmed yet, and requires the final summary to preserve that uncertainty explicitly.",
          "A second note prioritizes dependency checks before any action and forbids presenting a proposed operation as though it had already been completed.",
          "The synthetic calendar contains two time windows, one in the morning and one in the afternoon, without identifying which window participants approved.",
          "The status record separates confirmed facts from assumptions and asks for a short justification whenever an item receives high priority.",
          "A technical note constrains the answer to the supplied context and forbids inventing sources, measurements, people, or outcomes that are not present.",
          "The task list contains one approval dependency, one independent reading task, and one task that must remain pending until a prerequisite is resolved.",
          "The fixture entry says evidence identifiers must be copied exactly in structured output and must not be replaced by descriptive aliases.",
          "The safety rule requires an explicit distinction between a proposed action, an authorized action, and a result confirmed by a tool response."
        ],
        "final_requests": [
          "Give a concise summary of the main constraints and identify what remains uncertain.",
          "Rank the pending items by priority without claiming that any action was executed.",
          "Identify the confirmed facts and separate them from assumptions.",
          "Recommend the safest next step using only the records above.",
          "Summarize the time commitments and state which time has not been approved.",
          "List the dependencies that prevent immediate execution.",
          "Produce the answer in the active structured schema with no extra prose.",
          "Use the active tool only when the case contract requires it.",
          "Explain in two short sentences which data is missing for a safe decision.",
          "Give a compact status report and preserve every evidence identifier exactly."
        ],
        "tool_history_user": "Inspect the synthetic schedule snapshot for 15 January 2030.",
        "tool_history_result": "{\"date\":\"2030-01-15\",\"entries\":2,\"confirmed\":1,\"source\":\"synthetic-fixture\"}"
      }
    },
    "structured_schema": {
      "name": "performance_summary",
      "description": "A bounded content-free performance fixture result.",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "minItems": 0,
            "maxItems": 8
          }
        },
        "required": [
          "summary",
          "priority",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "tool": {
      "type": "function",
      "function": {
        "name": "inspect_schedule_snapshot",
        "description": "Read one already-authorized local synthetic schedule snapshot; this fixture never executes a real action.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10
            },
            "scope": {
              "type": "string",
              "enum": [
                "day",
                "week"
              ]
            }
          },
          "required": [
            "date",
            "scope"
          ],
          "additionalProperties": false
        }
      }
    }
  },
